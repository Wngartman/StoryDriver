<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StoryDriver</AssemblyName>
    <RootNamespace>StoryDriver.Desktop</RootNamespace>
    <ApplicationIcon>..\..\assets\desktop\storydriver.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Version>1.0.0</Version>
    <Company>StoryDriver</Company>
    <Product>StoryDriver</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\desktop\storydriver-loading.png" Link="Assets\storydriver-loading.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\desktop\storydriver.ico" Link="Assets\storydriver.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
