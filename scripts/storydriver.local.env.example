# Copy this file to scripts\storydriver.local.env or D:\StoryDriver\.env,
# then fill in any local service launch commands you want StoryDriver to use.

OPEN_BROWSER_AFTER_START=true
OPEN_BROWSER_ALWAYS=false
STORYDRIVER_FRONTEND_URL=http://localhost:5173
STORYDRIVER_BACKEND_URL=http://localhost:8001

LM_STUDIO_OPENAI_BASE_URL=http://localhost:1234/v1
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_REST_BASE_URL=http://localhost:1234/api/v1
LM_STUDIO_API_TOKEN=
LM_STUDIO_WORKING_DIR=
LM_STUDIO_START_COMMAND=
LM_STUDIO_WAIT_SECONDS=45

KOKORO_BASE_URL=http://localhost:8880
KOKORO_SPEECH_ENDPOINT=/v1/audio/speech
KOKORO_WORKING_DIR=
KOKORO_START_COMMAND=
KOKORO_WAIT_SECONDS=45

COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_WORKING_DIR=C:\Users\wngar\Documents\ComfyUI
COMFYUI_START_COMMAND=
COMFYUI_WAIT_SECONDS=60
COMFYUI_LAUNCH_ARGS=Manual ComfyUI Desktop mode. Open ComfyUI Desktop first.
COMFYUI_EXPECTED_BACKEND=rocm
COMFYUI_PERF_NOTES=StoryDriver checks/reuses the ComfyUI Desktop backend and does not launch or close ComfyUI by default.

# false: reuse existing StoryDriver/Kokoro services and avoid duplicate windows.
# true: safely restart only services whose process command line is clearly StoryDriver-owned
# or launched from KOKORO_WORKING_DIR.
RESTART_EXISTING_SERVICES=false
